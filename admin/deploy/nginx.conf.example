# /etc/nginx/sites-available/sfb-panel
#
# Схема «всё на одном домене» (как caseadvisory.uz):
#   caseadvisory.uz/taxtapul  → лендинг (статика, отдаёт nginx напрямую)
#   caseadvisory.uz/admin     → админ-панель (проксируется в Node на :3000)
#
# После правки: ln -s в sites-enabled, nginx -t && systemctl reload nginx,
# затем HTTPS: apt install certbot python3-certbot-nginx && certbot --nginx

server {
    listen 80;
    server_name caseadvisory.uz www.caseadvisory.uz;   # ← ваш домен

    client_max_body_size 25m;                          # загрузка фото до 20 МБ

    # ── лендинги: собранная статика из admin/sites/<slug> ──
    location /taxtapul/ {
        alias /opt/case-site/admin/sites/takhtapul/;   # ← путь до собранного лендинга
        index index.html;
        try_files $uri $uri/ =404;
    }
    location = /taxtapul { return 301 /taxtapul/; }

    # новый лендинг = ещё один такой же блок location с другим slug

    # ── админ-панель ──
    location = /admin { return 301 /admin/; }
    location /admin/ {
        proxy_pass http://127.0.0.1:3000/;             # завершающий / срезает префикс /admin
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # ── здесь остаётся ваш существующий сайт (корень домена) ──
    # location / { ... }
}

# Вариант с отдельными доменами (если так удобнее):
