# Закрыть прямой HTTP-доступ к конфигу, библиотеке и файлам БД
<FilesMatch "(^config\.php$|\.sqlite$|^lib\.php$)">
  Require all denied
</FilesMatch>

Options -Indexes
<FilesMatch "(^config\.php$|^config\..*\.php$|^lib\.php$|\.sqlite$|\.sql$|\.sql\.gz$|\.log$|^\.env$)">
  Require all denied
</FilesMatch>
