# CASE OS — сжатие и кэширование статики (ускоряет загрузку ~в 4-5 раз на медленной сети).
# Работает на стандартном Apache-хостинге (cPanel); если модуль не установлен — просто игнорируется.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  # index.html и sw.js всегда свежие (обновления платформы подхватываются сразу)
  ExpiresByType text/html "access plus 0 seconds"
  # данные квиза и статика могут кэшироваться, PWA-кэш обновит их при смене версии sw.js
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType image/svg+xml "access plus 1 day"
  ExpiresByType application/pdf "access plus 1 day"
</IfModule>


<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "same-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # v4.35 (P2): HSTS — только по HTTPS (env=HTTPS), год; без preload/includeSubDomains,
  # чтобы не заблокировать соседние поддомены хостинга.
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  # v4.35 (P2): CSP. 'unsafe-inline'/'unsafe-eval' вынужденные: платформа — один файл с
  # inline-скриптами и onclick-обработчиками, jszip использует Function. Политика всё равно
  # закрывает главное: чужие домены скриптов, form-action, base-uri, встраивание в чужие фреймы.
  # Карт-тайлы (img) и внешние API — только https.
  # v4.50.3: политика запрещала ровно то, что страница грузит сама — PptxGenJS с jsDelivr
  # и шрифты Google. Из-за этого выгрузка в PPTX на боевом Apache падала, а типографика
  # откатывалась на запасной шрифт. Перечислены ровно эти источники, не https: целиком.
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; connect-src 'self' https:; font-src 'self' data: https://fonts.gstatic.com; frame-src 'self' blob: data:; object-src 'self' data: blob:; worker-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

Options -Indexes

# v4.50.3: дампы базы и схему нельзя забирать по прямой ссылке. Запрет на .sql.gz стоял
# только в /api, а сами копии лежали в /sql/backups — то есть были доступны любому, кто
# угадает имя. Имена предсказуемы с точностью до секунды, так что это не теория.
<FilesMatch "\.(sql|sql\.gz|sqlite|sqlite3|log|env)$">
  Require all denied
</FilesMatch>
