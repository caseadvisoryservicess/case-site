# CASE OS — сжатие и кэширование статики (ускоряет загрузку ~в 4-5 раз на медленной сети).
# Работает на стандартном Apache-хостинге (cPanel); если модуль не установлен — просто игнорируется.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  # index.html и sw.js всегда свежие (обновления платформы подхватываются сразу)
  ExpiresByType text/html "access plus 0 seconds"
  # данные квиза и статика могут кэшироваться, PWA-кэш обновит их при смене версии sw.js
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType image/svg+xml "access plus 1 day"
  ExpiresByType application/pdf "access plus 1 day"
</IfModule>


<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "same-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

Options -Indexes
