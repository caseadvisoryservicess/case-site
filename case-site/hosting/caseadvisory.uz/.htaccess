# ── Корень домена caseadvisory.uz ────────────────────────────────────────────
# Место на сервере: /domains/caseadvisory.uz/public_html/.htaccess
#
# Домен .uz уводит на .com, но НЕ весь: здесь живут лендинги, панель лендингов
# и платформа CASE OS. Каждое правило заканчивается [L], поэтому решает первое
# совпавшее - порядок важнее содержания.
#
# ВНИМАНИЕ ПЕРЕД ЗАМЕНОЙ. Этот файл на сервере со временем оброс правилами,
# которых нет здесь. Откройте старый, сравните и перенесите всё, чего не хватает,
# прежде чем сохранять. Особенно строки Redirect и RedirectMatch: это 301 со
# старых адресов, и они молча исчезнут вместе с прежним файлом.

RewriteEngine On

# ── 0. Проверка сертификата. Обязана быть первой ────────────────────────────
# Let's Encrypt продлевает сертификат, запрашивая файл по адресу
# http://caseadvisory.uz/.well-known/acme-challenge/<токен>. Если увести на .com
# и его, продление молча не пройдёт, а через 90 дней сертификат кончится. Дальше
# сработает HSTS из os/.htaccess - он выдан на год и действует на весь домен,
# а не на папку, - и браузер упрётся в ошибку ДО того, как сервер увидит запрос.
RewriteRule ^\.well-known/ - [L]

# ── 1. Служебные файлы в корне ──────────────────────────────────────────────
# Подтверждения прав на домен и указания поисковикам обязаны отдаваться с .uz:
# уехав на .com, они перестают подтверждать что-либо.
RewriteRule ^(robots\.txt|sitemap\.xml|favicon\.ico|ads\.txt)$ - [L]
RewriteRule ^(yandex_[^/]+|google[0-9a-f]+\.html)$ - [L]

# ── 2. Старые адреса: 301 внутри .uz ────────────────────────────────────────
# Ресторан переезжал дважды, ссылки со старого адреса ещё ходят.
RewriteRule ^restaurant(/.*)?$ /mercure-restaurant/ [R=301,L]
# Слаг в панели - takhtapul, папка на проде - taxtapul. Ссылка, собранная по
# слагу, вела в никуда; теперь она доводит до нужного адреса, а не на .com.
RewriteRule ^takhtapul(/.*)?$ /taxtapul$1 [R=301,L,NC]
RewriteRule ^taktapul(/.*)?$ /taxtapul$1 [R=301,L,NC]

# ── 3. Разделы, которые остаются на .uz ─────────────────────────────────────
#
#    ЭТО ЕДИНСТВЕННОЕ МЕСТО, ГДЕ ОНИ ПЕРЕЧИСЛЕНЫ.
#    Публикуете лендинг - дописываете его папку сюда через | и больше ничего
#    не трогаете. Либо кладёте его в public_html/lp/ и не трогаете даже это.
#
#    os                - платформа CASE OS
#    admin             - панель лендингов
#    lp                - общая папка под будущие лендинги
#    taxtapul          - Тахтапул
#    galaba            - G'alaba
#    kibray-dc         - Кибрай, участок под ЦОД
#    mercure-restaurant - ресторан при отеле Mercure
#    botanica          - бизнес-центр Botanica
#
#    Mercure и Botanica числятся черновиками. Если они уже лежат на сервере и
#    показывать их пока нельзя - уберите два имени из строки ниже, тогда они
#    снова будут уходить на .com.
RewriteCond %{REQUEST_URI} ^/(os|admin|lp|taxtapul|galaba|kibray-dc|mercure-restaurant|botanica)($|/) [NC]
RewriteRule ^ - [E=CASE_STAY:1]

# ── 4. Эти разделы поднимаем с http на https в пределах .uz ─────────────────
# X-Forwarded-Proto - на случай, если TLS терминируется на прокси хостера
# и переменная HTTPS до Apache не доходит.
RewriteCond %{ENV:CASE_STAY} =1
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ── 5. ...и на .com не отправляем ───────────────────────────────────────────
RewriteCond %{ENV:CASE_STAY} =1
RewriteRule ^ - [L]

# ── 6. Всё остальное - на .com ──────────────────────────────────────────────
# Путь и строка запроса сохраняются: mod_rewrite сам добавляет исходный запрос,
# если в подстановке нет своего знака вопроса. Слэш после домена стоит явно -
# прежнее правило на mod_alias склеивало адрес в caseadvisory.comos.
#
# R=302, а НЕ 301, намеренно и временно. Постоянную переадресацию браузер
# запоминает надолго и без спроса - именно поэтому лендинги продолжат уезжать
# у тех, кто уже открывал их при старом правиле. Проверьте все адреса и только
# потом меняйте на 301: поисковым системам нужен именно он.
RewriteCond %{HTTP_HOST} ^(www\.)?caseadvisory\.uz$ [NC]
RewriteRule ^(.*)$ https://caseadvisory.com/$1 [R=302,L]
