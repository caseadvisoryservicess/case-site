# ── Корень домена caseadvisory.uz ────────────────────────────────────────────
# Место на сервере: /domains/caseadvisory.uz/public_html/.htaccess
#
# Задача файла: увести весь сайт .uz на .com, оставив на .uz две вещи, которые
# уводить нельзя, - платформу CASE OS и проверку сертификата.
#
# Порядок правил здесь важнее их содержания: каждое заканчивается [L], поэтому
# первое совпавшее и решает исход.

RewriteEngine On

# ── 1. Проверка сертификата. Это правило обязано быть первым ────────────────
# Let's Encrypt продлевает сертификат, запрашивая файл по адресу
# http://caseadvisory.uz/.well-known/acme-challenge/<токен>. Если переадресация
# перехватит и этот адрес, проверка уедет на .com, продление не пройдёт, и через
# 90 дней сертификат .uz просто закончится.
#
# Дальше срабатывает HSTS: os/.htaccess отдаёт Strict-Transport-Security на год,
# а он действует на весь домен, а не на папку /os. Браузер, однажды открывший
# платформу, целый год откажется ходить на caseadvisory.uz по http и упрётся в
# ошибку сертификата ДО того, как сервер увидит запрос. Со стороны это выглядит
# ровно как «переадресация перестала работать», хотя правило на месте.
RewriteRule ^\.well-known/ - [L]

# ── 2. Платформа: http на https в пределах .uz ──────────────────────────────
# Остальной сайт и так уходит на https://caseadvisory.com, а /os остаётся здесь,
# и ему нужен свой подъём до https. X-Forwarded-Proto - на случай, если хостинг
# терминирует TLS на прокси и переменная HTTPS до Apache не доходит.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{REQUEST_URI} ^/os($|/)
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ── 3. Платформа остаётся на .uz ────────────────────────────────────────────
# Именно .uz обслуживается этим хостингом; .com указывает на другой сервер,
# и переадресовать туда /os значит увести платформу в никуда.
RewriteRule ^os($|/) - [L]

# ── 4. Всё остальное - на .com ──────────────────────────────────────────────
# Путь и строка запроса сохраняются: mod_rewrite сам добавляет исходный запрос,
# если в подстановке нет своего знака вопроса.
#
# Ошибка, которая тут была раньше: `Redirect 301 / https://caseadvisory.com`
# из mod_alias дописывает путь к строке БЕЗ разделителя, и /os/ превращался
# в caseadvisory.comos/. Здесь слэш стоит явно.
#
# R=302, а НЕ 301, намеренно и временно. Постоянную переадресацию браузер
# запоминает надолго и без спроса; если в адресе окажется опечатка, отменить её
# у пользователей уже нельзя. Проверьте, что всё открывается правильно, и только
# после этого поменяйте 302 на 301 - для поисковых систем нужен именно 301.
RewriteCond %{HTTP_HOST} ^(www\.)?caseadvisory\.uz$ [NC]
RewriteRule ^(.*)$ https://caseadvisory.com/$1 [R=302,L]
