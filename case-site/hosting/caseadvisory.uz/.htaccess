# ── Корень домена caseadvisory.uz ────────────────────────────────────────────
# Место на сервере: /domains/caseadvisory.uz/public_html/.htaccess
#
# Домен .uz уводит на .com, но НЕ весь: часть разделов живёт именно здесь.
# Каждое правило заканчивается [L], поэтому решает первое совпавшее -
# порядок здесь важнее содержания.

RewriteEngine On

# ── 0. Проверка сертификата. Обязана быть первой ────────────────────────────
# Let's Encrypt продлевает сертификат, запрашивая файл по адресу
# http://caseadvisory.uz/.well-known/acme-challenge/<токен>. Прежнее правило
# уводило и его на .com: проверка не проходила, и через 90 дней сертификат
# заканчивался. Дальше срабатывал HSTS из os/.htaccess (год, на весь домен,
# а не на папку), и браузер упирался в ошибку ДО того, как сервер видел запрос.
RewriteRule ^\.well-known/ - [L]

# ── 1. Список разделов, которые остаются на .uz ─────────────────────────────
#
#    ЭТО ЕДИНСТВЕННОЕ МЕСТО, ГДЕ ОН ПЕРЕЧИСЛЕН.
#    Появился новый лендинг - допишите его папку через | и больше ничего
#    не трогайте. Раньше список был размазан по двум правилам, и лендинг
#    takhtapul забыли добавить: его выбрасывало на .com, где его нет.
#
#    os        - платформа CASE OS
#    admin     - панель управления лендингами
#    lp        - общая папка под будущие лендинги (см. ниже)
#    ta[kx]h?tapul - лендинг Тахтапул
#
#    Про последнюю строку. В проекте гуляют ЧЕТЫРЕ написания одного названия:
#    taxtapul, takhtapul, taktapul, Taxtapul. В репозитории папка называется
#    takhtapul, а admin/HOSTING.md требует адрес /taxtapul. Точное совпадение
#    здесь уже подвело один раз, поэтому шаблон принимает все варианты, а [NC]
#    снимает вопрос регистра.
#
#    Чтобы это не повторялось: новые лендинги кладите в public_html/lp/,
#    тогда трогать этот файл вообще не придётся - /lp уже в списке.
RewriteCond %{REQUEST_URI} ^/(os|admin|lp|ta[kx]h?tapul)($|/) [NC]
RewriteRule ^ - [E=CASE_STAY:1]

# ── 2. Эти разделы поднимаем с http на https в пределах .uz ─────────────────
# X-Forwarded-Proto - на случай, если TLS терминируется на прокси хостера
# и переменная HTTPS до Apache не доходит.
RewriteCond %{ENV:CASE_STAY} =1
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ── 3. ...и на .com не отправляем ───────────────────────────────────────────
RewriteCond %{ENV:CASE_STAY} =1
RewriteRule ^ - [L]

# ── 4. Всё остальное - на .com ──────────────────────────────────────────────
# Путь и строка запроса сохраняются: mod_rewrite сам добавляет исходный запрос,
# если в подстановке нет своего знака вопроса. Слэш после домена стоит явно -
# прежнее правило на mod_alias склеивало адрес в caseadvisory.comos.
#
# R=302, а НЕ 301, намеренно и временно. Постоянную переадресацию браузер
# запоминает надолго и без спроса - именно поэтому лендинг будет продолжать
# уезжать на .com у тех, кто уже открывал его при старом правиле. Проверьте,
# что всё работает, и только после этого меняйте 302 на 301: поисковым
# системам нужен именно 301.
RewriteCond %{HTTP_HOST} ^(www\.)?caseadvisory\.uz$ [NC]
RewriteRule ^(.*)$ https://caseadvisory.com/$1 [R=302,L]
